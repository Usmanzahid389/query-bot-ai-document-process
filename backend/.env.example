DATABASE_URL=sqlite+aiosqlite:///./querybot.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=10485760

# PDF: auto | hybrid | opendataloader = OpenDataLoader first, PyMuPDF merge if incomplete (plain lists).
# pymupdf = PyMuPDF only (no OpenDataLoader).
# PDF_PARSER=auto

# RAG: OpenAI-compatible LLM (OpenRouter, Groq, etc.)
# CHROMA_DIR=./chroma_db
# CHROMA_COLLECTION=querybot_documents
# EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# BGE example:
# EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
# For BGE, query prefix is auto-applied by default when EMBEDDING_AUTO_PREFIX_BGE=true.
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_AUTO_PREFIX_BGE=true
# OpenRouter example:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Groq example (model IDs differ — see https://console.groq.com/docs/models):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_api_key
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# Chat Q&A: number of chunks sent to the LLM (default 7). Page-specific questions use RAG_PAGE_RETRIEVAL_K.
# RAG_QA_TOP_K=7
# RAG_PAGE_RETRIEVAL_K=80
# Chat Q&A: set true to use MMR for chat too.
# RAG_QA_USE_MMR=false
# RAG_TOP_K=22
# RAG_SUMMARY_TOP_K=12
# Summary path: MMR when RAG_MMR_ENABLED (pull RAG_FETCH_K, keep top-k for LLM).
# RAG_FETCH_K=56
# RAG_MMR_ENABLED=true
# RAG_MMR_LAMBDA=0.82
# RAG_SUMMARY_FETCH_K=
# Stronger retrieval: try a larger EMBEDDING_MODEL_ID (heavier RAM/index time).
